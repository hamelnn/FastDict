{
  "name": "fastlingo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "android": "node scripts/mobile.mjs android dev",
    "android:init": "node scripts/mobile.mjs android init",
    "android:build": "node scripts/mobile.mjs android build",
    "android:check": "node scripts/mobile.mjs android check",
    "ios": "node scripts/mobile.mjs ios dev",
    "ios:init": "node scripts/mobile.mjs ios init",
    "ios:build": "node scripts/mobile.mjs ios build",
    "ios:check": "node scripts/mobile.mjs ios check",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "predev": "npm run prepare:ocr",
    "prebuild": "npm run prepare:ocr",
    "test:e2e": "playwright test",
    "windows:build": "node scripts/build-windows.mjs",
    "windows:installer": "node scripts/build-windows.mjs --installer",
    "macos:build": "node scripts/build-macos.mjs",
    "test:macos-build": "node --test scripts/__tests__/macos-build.test.mjs",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "check": "npm run test && npm run test:scripts && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-http": "^2.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.4"
  }
}
