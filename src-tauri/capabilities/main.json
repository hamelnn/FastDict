{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Bundled translation interface: events, window controls, clipboard and user-selected API endpoints.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*:*" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://[\\:\\:1]:*" }
      ]
    }
  ]
}
